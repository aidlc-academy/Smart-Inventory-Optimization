# ── PostgreSQL (Supabase) ─────────────────────────────────────────────────────
# sslmode must NOT appear here; TLS is configured in code with the CA cert.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Project URL — Project Settings > API > Project URL
SUPABASE_URL=https://your-project.supabase.co

# Publishable / anon key — Project Settings > API > Project API keys > anon public
# Safe to use on the server; used only to call supabase.auth.getUser().
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# Service-role key — used ONLY in admin scripts (assign-legacy-data.ts).
# NEVER expose this to the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
